; ── Cyclic events (keep last — see FALLFEST.SCR) ─────────────────────────────

; CEVENT 9300: Marren's lantern hint. A GM types @set HWHINT 1; within ~30s a
; ghostly lantern-light drifts toward the current stage's location, as seen
; from every cemetery room, then HWHINT resets to 0.
CEVENT 9300 10 310
IFVAR HWHINT = 1
  EQUAL HWHINT 0
  IFVAR HWLANTERN = 2
    AFFECT 287
    ECHO ALL Beyond the chained gate, a hooded lantern glimmers among the graves and drifts deeper into the cemetery.
    AFFECT 299
    ECHO ALL A faint lantern-light bobs away from you along the trail to the southwest.
    AFFECT 300
    ECHO ALL A ghostly lantern-light hovers for a moment over the skull beside the broken obelisk, then winks out.
    AFFECT 301
    ECHO ALL A faint lantern-light glimmers to the east, back toward the broken obelisk.
    AFFECT 302
    ECHO ALL A faint lantern-light glimmers off to the northeast.
    AFFECT 307
    ECHO ALL A faint lantern-light glimmers off to the east.
    AFFECT 308
    ECHO ALL Through the broken wall you glimpse a lantern-light drifting away to the east.
    AFFECT 309
    ECHO ALL A faint lantern-light glimmers to the south.
    AFFECT 310
    ECHO ALL Below the hillock, a faint lantern-light drifts south along the trail.
  ENDIF
  IFVAR HWLANTERN = 3
    AFFECT 287
    ECHO ALL Beyond the chained gate, a hooded lantern glimmers among the graves and drifts deeper into the cemetery.
    AFFECT 299
    ECHO ALL A faint lantern-light bobs away from you along the trail to the southwest.
    AFFECT 300
    ECHO ALL A faint lantern-light drifts away to the west, under the hanging willow.
    AFFECT 301
    ECHO ALL A faint lantern-light drifts north, toward a great grey-leaved tree.
    AFFECT 302
    ECHO ALL A faint lantern-light glimmers off to the northeast.
    AFFECT 307
    ECHO ALL A faint lantern-light glimmers off to the east.
    AFFECT 308
    ECHO ALL Through the broken wall you glimpse a lantern-light drifting away to the east.
    AFFECT 309
    ECHO ALL A ghostly lantern-light sinks slowly down among the roots of the Maytan tree, then winks out.
    AFFECT 310
    ECHO ALL Below the hillock, a faint lantern-light hovers by the grey-leaved tree to the south.
  ENDIF
  IFVAR HWLANTERN = 4
    AFFECT 287
    ECHO ALL Beyond the chained gate, a hooded lantern glimmers among the graves and drifts deeper into the cemetery.
    AFFECT 299
    ECHO ALL A faint lantern-light bobs away from you along the trail to the southwest.
    AFFECT 300
    ECHO ALL A faint lantern-light drifts away to the west, under the hanging willow.
    AFFECT 301
    ECHO ALL A faint lantern-light drifts away to the southwest, past the empty grave.
    AFFECT 302
    ECHO ALL A faint lantern-light drifts west, toward a crumbling granite house.
    AFFECT 307
    ECHO ALL A ghostly lantern-light drifts through the collapsed wall into the ruined house.
    AFFECT 308
    ECHO ALL A ghostly lantern-light hovers over the remains of the rusted bed, then sinks into the floor beneath it.
    AFFECT 309
    ECHO ALL A faint lantern-light glimmers to the south.
    AFFECT 310
    ECHO ALL Below the hillock, a faint lantern-light drifts south along the trail.
  ENDIF
  IFVAR HWLANTERN > 4
    IFVAR HWLANTERN < 8
      AFFECT 287
      ECHO ALL Beyond the chained gate, a hooded lantern glimmers among the graves and drifts deeper into the cemetery.
      AFFECT 299
      ECHO ALL A faint lantern-light bobs away from you along the trail to the southwest.
      AFFECT 300
      ECHO ALL A faint lantern-light drifts away to the west, under the hanging willow.
      AFFECT 301
      ECHO ALL A faint lantern-light drifts north, past the grey-leaved tree.
      AFFECT 302
      ECHO ALL A faint lantern-light glimmers off to the northeast.
      AFFECT 307
      ECHO ALL A faint lantern-light glimmers off to the east.
      AFFECT 308
      ECHO ALL Through the broken wall you glimpse a lantern-light drifting away to the east.
      AFFECT 309
      ECHO ALL A faint lantern-light drifts north, up toward the mausoleum on the hillock.
      AFFECT 310
      IFVAR HWLANTERN = 5
        ECHO ALL A ghostly lantern-light drifts around behind the mausoleum, into the tall weeds, and is gone.
      ENDIF
      IFVAR HWLANTERN = 6
        ECHO ALL A ghostly lantern-light hovers above the iron-bound chest. Somewhere, very faintly, someone whispers a name: "Marren..."
      ENDIF
      IFVAR HWLANTERN = 7
        ECHO ALL A ghostly lantern-light drifts slowly from grave to grave among the broken stones, as if searching.
      ENDIF
    ENDIF
  ENDIF
ENDIF
