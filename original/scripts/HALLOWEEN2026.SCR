IFPREVERB UNLOCK 12
  CLEARVERB
  IFVAR HWLANTERN >= 8
    ECHO PLAYER The chest already stands open.
  ELSE
    EQUAL DUMMY1 0
    IFCARRY 9304
      EQUAL DUMMY1 1
    ENDIF
    IFVAR DUMMY1 = 0
      ECHO PLAYER The chest is held shut by an old brass lock. You have no key that fits it.
    ELSE
      IFVAR HWLANTERN = 6
        ECHO PLAYER The tarnished brass key slides smoothly into the lock... but it will not turn. It is as if the lock is waiting for something.
        ECHO OTHERS %N fits a brass key into the chest's lock, but it will not turn.
      ELSE
        ECHO PLAYER The key will not turn. Somewhere close by, something waits for its funeral tokens to be returned to their graves.
        ECHO OTHERS %N tries the brass key in the chest's lock, but it will not turn.
      ENDIF
    ENDIF
  ENDIF
ENDIF
IFPREVERB OPEN 12
  CLEARVERB
  IFVAR HWLANTERN >= 8
    ECHO PLAYER The chest already stands open. (SEARCH CHEST to take your share.)
  ELSE
    ECHO PLAYER The iron-bound chest is locked tight.
  ENDIF
ENDIF
