; ── Cyclic events ─────────────────────────────────────────────────────────────
; Keep these LAST: a CEVENT body runs until the next NUMBER/INUMBER/MNUMBER/
; CEVENT/MACRO line, so anything after one (vocabulary, VARIABLEs) would be
; swallowed into it.

; CEVENT 9350 (every ~90s): festival revelry around the city. One random line
; in one random festival-route room per firing.
CEVENT 9350 30 206
IFVAR HWQUIET = 0
  RANDOM HWRND 1 14
  IFVAR HWRND = 1
    AFFECT 206
    ECHO ALL A troupe of children in paper masks runs shrieking through the bazaar, chased by a laughing youth draped in a bedsheet.
  ENDIF
  IFVAR HWRND = 2
    AFFECT 202
    ECHO ALL A juggler in a pumpkin mask tosses flaming torches high into the air to scattered applause.
  ENDIF
  IFVAR HWRND = 3
    AFFECT 209
    ECHO ALL The smell of roasting nuts and hot cider drifts through the bazaar.
  ENDIF
  IFVAR HWRND = 4
    AFFECT 203
    ECHO ALL A merchant hangs a string of paper bats over his stall, then steps back to admire them.
  ENDIF
  IFVAR HWRND = 5
    AFFECT 250
    ECHO ALL A crier calls out, "Fall Festival tonight! Stories by the fire at the cemetery gate in the Poor Quarter! Free cider!"
  ENDIF
  IFVAR HWRND = 6
    AFFECT 253
    ECHO ALL A couple strolls past arm in arm, sharing a caramel apple and arguing cheerfully about ghosts.
  ENDIF
  IFVAR HWRND = 7
    AFFECT 286
    ECHO ALL Laughter and the crackle of a bonfire drift up the alley from the west.
  ENDIF
  IFVAR HWRND = 8
    AFFECT 287
    ECHO ALL Someone near the campfire begins a ghost story, and the listeners lean in close.
  ENDIF
  IFVAR HWRND = 9
    AFFECT 287
    ECHO ALL A balloon slips free of the cart and drifts up past the paper lanterns into the dark.
  ENDIF
  IFVAR HWRND = 10
    AFFECT 287
    ECHO ALL The campfire pops loudly, and half the people around it jump.
  ENDIF
  IFVAR HWRND = 11
    AFFECT 265
    ECHO ALL Jack-o'-lanterns grin from the park railings, their candles guttering in the breeze.
  ENDIF
  IFVAR HWRND = 12
    AFFECT 201
    ECHO ALL The gate guards have stuck a carved pumpkin on top of the gatehouse, and are pretending not to be proud of it.
  ENDIF
  IFVAR HWRND = 13
    AFFECT 224
    ECHO ALL A vendor hawks sugar skulls from a tray hung around his neck. "Sweet as sin and half the price!"
  ENDIF
  IFVAR HWRND = 14
    AFFECT 288
    ECHO ALL A pair of revelers in mismatched costumes stagger past, singing a song that has lost most of its words.
  ENDIF
ENDIF

; CEVENT 9351 (every ~2m): chill winds and unease around the cemetery.
CEVENT 9351 40 299
IFVAR HWQUIET = 0
  RANDOM HWRND2 1 10
  IFVAR HWRND2 = 1
    AFFECT 287
    ECHO ALL A cold wind gusts out from between the cemetery gate's bars, and the campfire flattens for a moment before springing back.
  ENDIF
  IFVAR HWRND2 = 2
    AFFECT 287
    ECHO ALL The chains on the cemetery gate clink softly, though no one is touching them.
  ENDIF
  IFVAR HWRND2 = 3
    AFFECT 299
    ECHO ALL A chill wind moans through the gravestones, carrying the faint sound of laughter from the festival beyond the gate.
  ENDIF
  IFVAR HWRND2 = 4
    AFFECT 300
    ECHO ALL Dead leaves skitter across the trail and settle against the broken obelisk.
  ENDIF
  IFVAR HWRND2 = 5
    AFFECT 301
    ECHO ALL The crows in the willow fall silent all at once, then resume their quarrelling.
  ENDIF
  IFVAR HWRND2 = 6
    AFFECT 309
    ECHO ALL The grey leaves of the Maytan tree whisper against the gravestones, though the air is still.
  ENDIF
  IFVAR HWRND2 = 7
    AFFECT 310
    ECHO ALL For a moment you could swear you see a light moving among the graves below the hillock. Then it is gone.
  ENDIF
  IFVAR HWRND2 = 8
    AFFECT 307
    ECHO ALL Something inside the ruined house creaks, like a sleeper turning over in a rusted bed.
  ENDIF
  IFVAR HWRND2 = 9
    AFFECT 302
    ECHO ALL A clod of earth tumbles into the empty grave beside the trail with a soft, final thump.
  ENDIF
  IFVAR HWRND2 = 10
    AFFECT 288
    ECHO ALL An icy draft curls out of the alley to the west, smelling of wet earth.
  ENDIF
ENDIF

; CEVENT 9352 (every ~2m): Halloween monster spawner, OFF unless @set HWHAUNT 1.
; Picks one cemetery room; spawns only if no creature is already there, so at
; most one Halloween monster per room (hostile ones don't wander, and the
; cemetery only connects to the city through the gate portal). Never spawns in
; the festival lot (287) or the caretaker's house (308).
CEVENT 9352 40 299
IFVAR HWHAUNT = 1
  RANDOM HWRND 1 8
  IFVAR HWRND = 1
    AFFECT 299
  ENDIF
  IFVAR HWRND = 2
    AFFECT 300
  ENDIF
  IFVAR HWRND = 3
    AFFECT 301
  ENDIF
  IFVAR HWRND = 4
    AFFECT 302
  ENDIF
  IFVAR HWRND = 5
    AFFECT 307
  ENDIF
  IFVAR HWRND = 6
    AFFECT 309
  ENDIF
  IFVAR HWRND = 7
    AFFECT 310
  ENDIF
  IFVAR HWRND = 8
    AFFECT 3186
  ENDIF
  IFVAR MONINROOM < 1
    RANDOM HWRND2 1 10
    IFVAR HWRND2 = 1
      GENMON 9350
    ENDIF
    IFVAR HWRND2 = 2
      GENMON 9351
    ENDIF
    IFVAR HWRND2 = 3
      GENMON 9351
    ENDIF
    IFVAR HWRND2 = 4
      GENMON 9352
    ENDIF
    IFVAR HWRND2 = 5
      GENMON 9355
    ENDIF
    IFVAR HWRND2 = 6
      GENMON 9355
    ENDIF
    IFVAR HWRND2 = 7
      GENMON 9356
    ENDIF
    IFVAR HWRND2 = 8
      GENMON 9357
    ENDIF
    IFVAR HWRND2 = 9
      GENMON 9358
    ENDIF
    IFVAR HWRND2 = 10
      GENMON 9354
    ENDIF
  ENDIF
ENDIF
