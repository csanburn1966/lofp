; ── Macros ────────────────────────────────────────────────────────────────────
; Each body is wrapped in an always-true IFVAR so every action parses as part of
; a nested block. DUMMY variables last only for the one command.

; MACRO 9400: SURVEY with the instrument (from HAVARTHITEMS.SCR item 9400).
;   DUMMY1 = which survey spot this room is in the current assignment (0 = none)
;   DUMMY2 = readings the assignment needs, DUMMY3 = readings taken so far
;   DUMMY4 = 1 if this spot's reading is already taken
;   DUMMY5 = the first four readings taken (assignment 4's way into the prospect)
;   DUMMY6 = 1 when this is the Lakeside Road spot that leads into the prospect
MACRO 9400
IFVAR DUMMY9 = 0
  CLEARVERB
  EQUAL DUMMY1 0
  EQUAL DUMMY2 0
  IFVAR INTNUM1040 = 1
    EQUAL DUMMY2 3
    IFVAR RNUM = 978
      EQUAL DUMMY1 1
    ENDIF
    IFVAR RNUM = 981
      EQUAL DUMMY1 2
    ENDIF
    IFVAR RNUM = 953
      EQUAL DUMMY1 3
    ENDIF
  ENDIF
  IFVAR INTNUM1040 = 3
    EQUAL DUMMY2 4
    IFVAR RNUM = 3402
      EQUAL DUMMY1 1
    ENDIF
    IFVAR RNUM = 3403
      EQUAL DUMMY1 2
    ENDIF
    IFVAR RNUM = 3404
      EQUAL DUMMY1 3
    ENDIF
    IFVAR RNUM = 3405
      EQUAL DUMMY1 4
    ENDIF
  ENDIF
  IFVAR INTNUM1040 = 5
    EQUAL DUMMY2 3
    IFVAR RNUM = 110
      EQUAL DUMMY1 1
    ENDIF
    IFVAR RNUM = 109
      EQUAL DUMMY1 2
    ENDIF
    IFVAR RNUM = 103
      EQUAL DUMMY1 3
    ENDIF
  ENDIF
  IFVAR INTNUM1040 = 7
    EQUAL DUMMY2 5
    IFVAR RNUM = 627
      EQUAL DUMMY1 1
    ENDIF
    IFVAR RNUM = 636
      EQUAL DUMMY1 2
    ENDIF
    IFVAR RNUM = 712
      EQUAL DUMMY1 3
    ENDIF
    IFVAR RNUM = 732
      EQUAL DUMMY1 4
    ENDIF
    IFVAR RNUM = 9413
      EQUAL DUMMY1 5
    ENDIF
  ENDIF
  EQUAL DUMMY5 INTNUM1041
  ADD DUMMY5 INTNUM1042
  ADD DUMMY5 INTNUM1043
  ADD DUMMY5 INTNUM1044
  EQUAL DUMMY3 DUMMY5
  ADD DUMMY3 INTNUM1045
  EQUAL DUMMY4 0
  IFVAR DUMMY1 = 1
    IFVAR INTNUM1041 = 1
      EQUAL DUMMY4 1
    ENDIF
  ENDIF
  IFVAR DUMMY1 = 2
    IFVAR INTNUM1042 = 1
      EQUAL DUMMY4 1
    ENDIF
  ENDIF
  IFVAR DUMMY1 = 3
    IFVAR INTNUM1043 = 1
      EQUAL DUMMY4 1
    ENDIF
  ENDIF
  IFVAR DUMMY1 = 4
    IFVAR INTNUM1044 = 1
      EQUAL DUMMY4 1
    ENDIF
  ENDIF
  IFVAR DUMMY1 = 5
    IFVAR INTNUM1045 = 1
      EQUAL DUMMY4 1
    ENDIF
  ENDIF
  EQUAL DUMMY6 0
  IFVAR RNUM = 740
    IFVAR INTNUM1040 = 7
      EQUAL DUMMY6 1
    ENDIF
    IFVAR INTNUM1040 = 8
      EQUAL DUMMY6 1
    ENDIF
  ENDIF
  IFVAR INCOMBAT = 1
    ECHO PLAYER You try to steady the instrument, but the needle jumps with every move you make. You'll have to deal with the danger first.
  ELSE
    IFVAR DUMMY6 = 1
      IFVAR DUMMY5 < 4
        IFVAR INTNUM1040 = 7
          ECHO PLAYER The mineral needle twitches toward a tumble of boulders beside the road, then sags back. It needs more readings from the mountains below before it can tell you anything.
          ECHO OTHERS %N fiddles with the dials of a brass instrument.
          EQUAL ROUNDTIME 2
          ECHO PLAYER [Round: 2 sec]
        ENDIF
      ENDIF
      IFVAR DUMMY5 >= 4
        EQUAL DUMMY7 1
      ENDIF
      IFVAR INTNUM1040 = 8
        EQUAL DUMMY7 1
      ENDIF
      IFVAR DUMMY7 = 1
        ECHO PLAYER The mineral needle swings hard toward a tumble of boulders beside the road and stays there, quivering. Behind the boulders you find a narrow cleft in the mountainside, just wide enough to squeeze through, and you squeeze through it.
        ECHO OTHERS %N follows the needle of a brass instrument behind a tumble of boulders and is gone.
        MOVE 9410
        AFFECT 9410
        ECHO OTHERS %N squeezes in through the cleft, a brass instrument in hand.
      ENDIF
    ELSE
      IFVAR DUMMY2 = 0
        IFVAR INTNUM1040 = 8
          ECHO PLAYER The needle settles, as it always does now, toward the Teeth of Shartan. Your surveying for the New Havarth Mining Company is done.
        ELSE
          ECHO PLAYER You turn the brass dials this way and that, but without an assignment from the New Havarth Mining Company you have no idea what you're meant to measure.
        ENDIF
      ELSE
        IFVAR DUMMY1 = 0
          ECHO PLAYER You take a few measurements. The mineral needle wanders aimlessly; nothing here is of interest to the company.
          ECHO OTHERS %N takes some measurements with a brass instrument.
          EQUAL ROUNDTIME 2
          ECHO PLAYER [Round: 2 sec]
        ELSE
          IFVAR DUMMY4 = 1
            ECHO PLAYER You've already recorded a reading here. The company needs measurements from other places.
          ELSE
            EQUAL INTNUM1049 0
            ADD DUMMY3 1
            IFVAR DUMMY3 >= DUMMY2
              EQUAL INTNUM1049 1
            ENDIF
            IFVAR DUMMY1 = 1
              EQUAL INTNUM1041 1
            ENDIF
            IFVAR DUMMY1 = 2
              EQUAL INTNUM1042 1
            ENDIF
            IFVAR DUMMY1 = 3
              EQUAL INTNUM1043 1
            ENDIF
            IFVAR DUMMY1 = 4
              EQUAL INTNUM1044 1
            ENDIF
            IFVAR DUMMY1 = 5
              EQUAL INTNUM1045 1
            ENDIF
            EQUAL DUMMY7 0
            IFVAR INTNUM1040 = 7
              IFVAR DUMMY1 = 5
                EQUAL DUMMY7 1
              ENDIF
            ENDIF
            IFVAR DUMMY7 = 1
              ECHO PLAYER The instrument's mineral needle swings violently before settling into a steady position. Several brass indicators register unusually strong readings.
            ELSE
              ECHO PLAYER You carefully adjust the instrument's brass dials and take a series of measurements. The mineral needle trembles briefly before settling into position.
            ENDIF
            ECHO OTHERS %N carefully adjusts the dials of a brass instrument and takes a series of measurements.
            CALL 9404
            EQUAL ROUNDTIME 5
            ECHO PLAYER [Round: 5 sec]
            PLREVENT 5
            CONTPLREVENT
            IFVAR INTNUM1040 = 7
              IFVAR INTNUM1049 = 1
                ECHO PLAYER Your measurements indicate a substantial mineral deposit beneath the surrounding stone. This location may be suitable for a new mining operation.
                ECHO PLAYER All required surveys have been completed. Return to the New Havarth Mining Company in Fayd.
              ELSE
                ECHO PLAYER A geological reading has been successfully recorded.
              ENDIF
            ELSE
              ECHO PLAYER A geological reading has been successfully recorded.
              IFVAR INTNUM1049 = 1
                ECHO PLAYER All required surveys have been completed. Return to the New Havarth Mining Company in Fayd.
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDIF
ENDIF

; MACRO 9401: talking to Edric about work, a survey or a report. The stage
; checks run from 8 down to 1, so starting assignment N+1 (which raises the
; stage) can't also trigger a later check in the same call.
MACRO 9401
IFVAR DUMMY9 = 0
  IFVAR INTNUM1040 = 0
    ECHO PLAYER Edric Havarth leans back in his chair. "Welcome to New Havarth Mining! You'll forgive the scaffolding. We intend to be around long enough to finish the building."
    ECHO PLAYER "My sister Mara has developed a surveying instrument, and I need someone willing to put it to use. The caves south of Fayd are our first concern. Take some readings, return with your findings, and I'll see you're properly compensated."
    ECHO PLAYER Mara Havarth bustles in from the surveying room and presses a brass instrument into your hands. "Three readings from the Inner Sea caves. The way in is the opening in the rocks at the water's edge. Use the instrument with SURVEY, and don't drop it down a hole."
    ECHO OTHERS Edric Havarth offers %N an assignment, and Mara hands %i a brass instrument.
    NEWITEM -1 9400 ADJ1=32 ADJ2=9400
    EQUAL INTNUM1040 1
    CALL 9408
  ELSE
    IFVAR INTNUM1046 = 1
      CALL 9409
    ELSE
      IFVAR INTNUM1040 = 8
        ECHO PLAYER Edric Havarth grins and taps a fresh pin deep in the Teeth of Shartan. "The expedition is being outfitted as we speak. Bram is having palpitations. When we break ground up there, it'll be on your readings, and I won't forget it."
      ENDIF
      IFVAR INTNUM1040 = 7
        ECHO PLAYER Edric taps the mountains on his map. "The Teeth of Shartan. Five readings. Ask Mara where, if you've forgotten, and come back alive."
      ENDIF
      IFVAR INTNUM1040 = 6
        ECHO PLAYER Edric Havarth stands and spreads his hands across the mountains on his map. "You've surveyed our caves, investigated a forgotten mine, and returned from the Grymwood with findings that have my sister practically sleeping over her maps."
        ECHO PLAYER "Now comes the real opportunity. The Teeth of Shartan. Dangerous country, certainly, but I believe those mountains conceal deposits that could make this company the wealthiest mining concern in Fayd."
        ECHO PLAYER "I need someone capable of exploring those mountains and returning alive with reliable geological readings. Find me a place worth digging, and you'll receive considerably more than a handful of coins."
        ECHO PLAYER Mara joins him at the map. "The mountains are vast, and you'll need readings from several elevations. Don't mistake a single rich vein for a workable deposit. We need evidence of something substantial. Come and ask me where, and I'll show you." She pauses. "And please, remember that a dead surveyor is of very little use to us."
        ECHO OTHERS Edric Havarth gives %N a new assignment.
        EQUAL INTNUM1040 7
        CALL 9408
      ENDIF
      IFVAR INTNUM1040 = 5
        ECHO PLAYER Edric taps the pin marking the Matriarch Tree. "The Grymwood. Three readings around the Matriarch, then back to Mara."
      ENDIF
      IFVAR INTNUM1040 = 4
        ECHO PLAYER Edric Havarth lowers his voice. "Mara's been studying some rather peculiar geological accounts from the Grymwood. Apparently, the earth surrounding the great Matriarch Tree contains stone unlike anything found nearer Fayd."
        ECHO PLAYER "I want you to investigate. Mind you, we're looking for minerals, not trouble with whatever calls that forest home. Take your readings and leave the tree standing."
        ECHO PLAYER Mara looks in from the doorway. "Three readings: one at the foot of the Matriarch, one in the room beneath her roots, and one in the little chamber at the end of the crevice below that. And Edric, she means it about the tree."
        ECHO OTHERS Edric Havarth gives %N a new assignment.
        EQUAL INTNUM1040 5
        CALL 9408
      ENDIF
      IFVAR INTNUM1040 = 3
        ECHO PLAYER Edric taps the pin marking the old dig east of the city. "The Abandoned Dig, one reading on each level. When you're done, see Mara."
      ENDIF
      IFVAR INTNUM1040 = 2
        ECHO PLAYER Edric Havarth rubs his chin. "You've proven you can handle yourself underground. Now I have something a little less pleasant."
        ECHO PLAYER "There's an old excavation east of Fayd, abandoned years ago. Nobody seems entirely certain why the operation ceased. I'd like to know whether the stone is exhausted or the previous owners simply lost their nerve."
        ECHO PLAYER Mara calls from the next room, "Four readings from the Abandoned Dig, one on each level of the shaft. The old platform still works, if you don't mind the ropes."
        ECHO OTHERS Edric Havarth gives %N a new assignment.
        EQUAL INTNUM1040 3
        CALL 9408
      ENDIF
      IFVAR INTNUM1040 = 1
        ECHO PLAYER Edric taps the pin on his map marking the Inner Sea caves. "The caves are waiting. When you have your readings, take them to Mara."
      ENDIF
    ENDIF
  ENDIF
ENDIF

; MACRO 9402: telling Mara the readings are done.
MACRO 9402
IFVAR DUMMY9 = 0
  EQUAL DUMMY2 0
  IFVAR INTNUM1040 = 1
    EQUAL DUMMY2 3
  ENDIF
  IFVAR INTNUM1040 = 3
    EQUAL DUMMY2 4
  ENDIF
  IFVAR INTNUM1040 = 5
    EQUAL DUMMY2 3
  ENDIF
  IFVAR INTNUM1040 = 7
    EQUAL DUMMY2 5
  ENDIF
  EQUAL DUMMY3 INTNUM1041
  ADD DUMMY3 INTNUM1042
  ADD DUMMY3 INTNUM1043
  ADD DUMMY3 INTNUM1044
  ADD DUMMY3 INTNUM1045
  STRCVT 0 DUMMY3
  STRCVT 1 DUMMY2
  IFVAR DUMMY2 = 0
    IFVAR INTNUM1040 = 8
      ECHO PLAYER Mara Havarth doesn't look up from her charts. "Those Shartan readings... I still can't sleep for thinking about them. Thank you."
    ELSE
      IFVAR INTNUM1040 = 0
        ECHO PLAYER Mara Havarth glances up. "Edric hands out the assignments. Talk to him first, in the main office."
      ELSE
        ECHO PLAYER Mara Havarth nods toward the main office. "Your report's been paid. Edric has your next assignment whenever you're ready."
      ENDIF
    ENDIF
  ELSE
    IFVAR INTNUM1046 = 1
      ECHO PLAYER Mara Havarth waves you toward the door. "I've already sent your report through to Edric. Go and see him."
    ELSE
      IFVAR DUMMY3 < DUMMY2
        ECHO PLAYER Mara Havarth checks the dials of your instrument against her charts. "%0 of the %1 readings. Not done yet. Ask me WHERE if you need directions."
      ELSE
        IFVAR INTNUM1040 = 1
          ECHO PLAYER Mara Havarth checks the dials of your instrument against her charts and nods. "Excellent. The readings suggest several deposits worth investigating. I'll prepare the report for Edric."
        ENDIF
        IFVAR INTNUM1040 = 3
          ECHO PLAYER Mara Havarth studies your readings for a long moment. "Interesting. The old miners may have overlooked something. These readings deserve a closer examination. I'll prepare the report for Edric."
        ENDIF
        IFVAR INTNUM1040 = 5
          ECHO PLAYER Mara Havarth stares at the dials, then at you. "These readings are extraordinary. Whatever lies beneath that forest may extend much farther than we imagined. I'll prepare the report for Edric."
        ENDIF
        IFVAR INTNUM1040 = 7
          ECHO PLAYER Mara Havarth reads the dials once, then again, very slowly. "Let me see those readings... By the mountains themselves!" She snatches up the report and hurries next door. "Edric, you need to look at this!"
        ELSE
          ECHO PLAYER She scribbles out a report and carries it through to the main office. "Edric is waiting for you."
        ENDIF
        ECHO OTHERS Mara Havarth checks %N's instrument and writes up a report.
        EQUAL INTNUM1046 1
      ENDIF
    ENDIF
  ENDIF
ENDIF

; MACRO 9403: a lost instrument. Mara replaces it for 5 gold crowns (500 copper),
; between or during assignments. Progress is on the character, not the
; instrument, so nothing is lost with it.
MACRO 9403
IFVAR DUMMY9 = 0
  IFVAR INTNUM1040 = 0
    ECHO PLAYER Mara Havarth sniffs. "Instruments are for company surveyors. Talk to Edric if you want work."
  ELSE
    IFVAR INTNUM1040 = 8
      ECHO PLAYER Mara Havarth smiles thinly. "Your surveying days are done. Keep the instrument, if you still have it, as a memento."
    ELSE
      IFCARRY 9400
        ECHO PLAYER Mara Havarth eyes the brass instrument you're carrying. "You already have one. Try not to lose it."
      ELSE
        IFVAR WEALTH < 500
          ECHO PLAYER Mara Havarth folds her arms. "A replacement costs five gold crowns. Brass and glass don't grow on trees. Come back when you have it."
        ELSE
          SUB WEALTH 500
          NEWITEM -1 9400 ADJ1=32 ADJ2=9400
          ECHO PLAYER Mara Havarth sighs, takes five gold crowns from you, and hands over a new brass instrument from a drawer. "Your readings are all in the company's books, so you've lost nothing but money. Try to keep hold of this one."
          ECHO OTHERS Mara Havarth sells %N a replacement brass instrument, with a sigh.
        ENDIF
      ENDIF
    ENDIF
  ENDIF
ENDIF

; MACRO 9404: what the instrument shows (LOOK at it, and after a reading).
MACRO 9404
IFVAR DUMMY9 = 0
  IFVAR INTNUM1040 = 0
    ECHO PLAYER The dials are all at rest. You have no assignment from the New Havarth Mining Company.
  ENDIF
  IFVAR INTNUM1040 = 1
    ECHO PLAYER Survey journal: the Inner Sea caves.
    IFVAR INTNUM1041 = 1
      ECHO PLAYER   [recorded] the cave entrance
    ELSE
      ECHO PLAYER   [ needed ] the cave entrance
    ENDIF
    IFVAR INTNUM1042 = 1
      ECHO PLAYER   [recorded] the tunnel where water streams down the walls
    ELSE
      ECHO PLAYER   [ needed ] the tunnel where water streams down the walls
    ENDIF
    IFVAR INTNUM1043 = 1
      ECHO PLAYER   [recorded] the deep caverns, where the warm and cold springs meet
    ELSE
      ECHO PLAYER   [ needed ] the deep caverns, where the warm and cold springs meet
    ENDIF
  ENDIF
  IFVAR INTNUM1040 = 3
    ECHO PLAYER Survey journal: the Abandoned Dig.
    IFVAR INTNUM1041 = 1
      ECHO PLAYER   [recorded] the upper shaft
    ELSE
      ECHO PLAYER   [ needed ] the upper shaft
    ENDIF
    IFVAR INTNUM1042 = 1
      ECHO PLAYER   [recorded] the middle shaft
    ELSE
      ECHO PLAYER   [ needed ] the middle shaft
    ENDIF
    IFVAR INTNUM1043 = 1
      ECHO PLAYER   [recorded] the lower shaft
    ELSE
      ECHO PLAYER   [ needed ] the lower shaft
    ENDIF
    IFVAR INTNUM1044 = 1
      ECHO PLAYER   [recorded] the bottom of the shaft
    ELSE
      ECHO PLAYER   [ needed ] the bottom of the shaft
    ENDIF
  ENDIF
  IFVAR INTNUM1040 = 5
    ECHO PLAYER Survey journal: beneath the Matriarch.
    IFVAR INTNUM1041 = 1
      ECHO PLAYER   [recorded] the foot of the Matriarch Tree
    ELSE
      ECHO PLAYER   [ needed ] the foot of the Matriarch Tree
    ENDIF
    IFVAR INTNUM1042 = 1
      ECHO PLAYER   [recorded] the room beneath her roots
    ELSE
      ECHO PLAYER   [ needed ] the room beneath her roots
    ENDIF
    IFVAR INTNUM1043 = 1
      ECHO PLAYER   [recorded] the chamber at the end of the crevice
    ELSE
      ECHO PLAYER   [ needed ] the chamber at the end of the crevice
    ENDIF
    IFVAR RNUM >= 103
      IFVAR RNUM <= 110
        ECHO PLAYER The needle behaves strangely here. It wavers, then swings away from north toward the distant Teeth of Shartan, and holds there for a moment before it settles.
      ENDIF
    ENDIF
  ENDIF
  IFVAR INTNUM1040 = 7
    ECHO PLAYER Survey journal: the Teeth of Shartan.
    IFVAR INTNUM1041 = 1
      ECHO PLAYER   [recorded] the ledge path, below the Padima Bridge
    ELSE
      ECHO PLAYER   [ needed ] the ledge path, below the Padima Bridge
    ENDIF
    IFVAR INTNUM1042 = 1
      ECHO PLAYER   [recorded] the boulder heights past the Paegar Bridge
    ELSE
      ECHO PLAYER   [ needed ] the boulder heights past the Paegar Bridge
    ENDIF
    IFVAR INTNUM1043 = 1
      ECHO PLAYER   [recorded] the landslides in the upper valley
    ELSE
      ECHO PLAYER   [ needed ] the landslides in the upper valley
    ENDIF
    IFVAR INTNUM1044 = 1
      ECHO PLAYER   [recorded] the foot of the great dam
    ELSE
      ECHO PLAYER   [ needed ] the foot of the great dam
    ENDIF
    IFVAR INTNUM1045 = 1
      ECHO PLAYER   [recorded] the prospect
    ELSE
      ECHO PLAYER   [ needed ] the prospect: survey along the Lakeside Road once the first four are done
    ENDIF
  ENDIF
  IFVAR INTNUM1046 = 1
    ECHO PLAYER Mara has your readings. Edric is waiting to see you.
  ENDIF
  IFVAR INTNUM1040 = 2
    ECHO PLAYER Your last report has been paid. Edric Havarth has more work for you.
  ENDIF
  IFVAR INTNUM1040 = 4
    ECHO PLAYER Your last report has been paid. Edric Havarth has more work for you.
  ENDIF
  IFVAR INTNUM1040 = 6
    ECHO PLAYER Your last report has been paid. Edric Havarth has more work for you.
  ENDIF
  IFVAR INTNUM1040 = 8
    ECHO PLAYER All four surveys are complete. The needle points, as it always does now, toward the Teeth of Shartan.
  ENDIF
ENDIF

; MACRO 9405: Bram Havarth, at the counter in room 394.
MACRO 9405
IFVAR DUMMY9 = 0
  IFVAR INTNUM1040 = 8
    ECHO PLAYER Bram Havarth peers at you over his spectacles. "Ah, the surveyor. Do you know what it'll cost to put a camp in those mountains? No, of course you don't. Nobody in this family does."
  ELSE
    ECHO PLAYER Bram Havarth jerks a thumb toward the staircase without looking up from his book. "Master Edric's upstairs, if it's work you're after. Mind you don't track mud on the steps."
  ENDIF
ENDIF

; MACRO 9406: where to take the readings (asking Mara WHERE).
MACRO 9406
IFVAR DUMMY9 = 0
  IFVAR INTNUM1040 = 1
    ECHO PLAYER Mara Havarth pulls a chart toward you. "The Inner Sea caves: go in through the opening in the rocks at the water's edge. One reading just inside the entrance, one in the old tunnel further down where the water streams down the walls, and one in the deep caverns through the hole at the end, where the hot and cold springs come together."
  ENDIF
  IFVAR INTNUM1040 = 3
    ECHO PLAYER Mara Havarth pulls a chart toward you. "The Abandoned Dig is east of the city, past the grasslands. Ride the old platform down the shaft and take one reading on each level: upper, middle, lower and the very bottom. Pull the ropes to move it."
  ENDIF
  IFVAR INTNUM1040 = 5
    ECHO PLAYER Mara Havarth pulls a chart toward you. "The Matriarch Tree, in the Grymwood. One reading at the foot of the tree, one in the room beneath her roots, and one in the little chamber at the end of the crevice below it. The tree's a dangerous place. Watch yourself."
  ENDIF
  IFVAR INTNUM1040 = 7
    ECHO PLAYER Mara Havarth unrolls her largest map of the Teeth of Shartan. "Two readings in the lower mountains, before the trail up from the canyon: one on the ledge path below the Padima Bridge, and one up among the boulder heights past the Paegar Bridge."
    ECHO PLAYER "Two more beyond the canyon trail: one where the landslides have torn open the upper valley, and one at the foot of the great dam."
    ECHO PLAYER "When you have those four, climb to the dam top and follow the Lakeside Road, surveying as you go. Where the instrument finds something worth finding, it will show you. Take the last reading there."
  ENDIF
  IFVAR INTNUM1040 = 0
    ECHO PLAYER Mara Havarth glances up. "Directions? To what? Edric hands out the assignments."
  ENDIF
  IFVAR INTNUM1040 = 2
    ECHO PLAYER Mara Havarth points at the main office. "Edric has your next assignment."
  ENDIF
  IFVAR INTNUM1040 = 4
    ECHO PLAYER Mara Havarth points at the main office. "Edric has your next assignment."
  ENDIF
  IFVAR INTNUM1040 = 6
    ECHO PLAYER Mara Havarth points at the main office. "Edric has your next assignment."
  ENDIF
  IFVAR INTNUM1040 = 8
    ECHO PLAYER Mara Havarth smiles faintly. "You've been everywhere I'd send you. For now."
  ENDIF
ENDIF

; MACRO 9407: Tessa Havarth, in the workshop.
MACRO 9407
IFVAR DUMMY9 = 0
  IFVAR INTNUM1040 = 8
    ECHO PLAYER Tessa Havarth looks up from the whetstone. "How's the axe treating you? If you ever strike something truly valuable, remember who made it."
  ELSE
    ECHO PLAYER Tessa Havarth holds up a battered pickaxe. "Whoever returned this ought to be ashamed of themselves. Look at that edge!" She lowers her voice. "Father has me making something special for whoever finishes his surveys. Don't ask. It isn't done."
  ENDIF
ENDIF

; MACRO 9408: start a fresh assignment (clear the readings and the report).
MACRO 9408
IFVAR DUMMY9 = 0
  EQUAL INTNUM1041 0
  EQUAL INTNUM1042 0
  EQUAL INTNUM1043 0
  EQUAL INTNUM1044 0
  EQUAL INTNUM1045 0
  EQUAL INTNUM1046 0
  EQUAL INTNUM1049 0
ENDIF

; MACRO 9409: Edric accepts the report and pays. Stage goes from odd to the
; next even number, so a report can't be paid twice. AWARD ids 1040-1043 make
; the experience once per character even if a GM resets the stage.
MACRO 9409
IFVAR DUMMY9 = 0
  IFVAR INTNUM1040 = 1
    ECHO PLAYER Edric Havarth reads the report and slaps the desk. "A promising beginning! Bram will see you're paid. Now, I have another location that requires your attention, when you're ready for more work."
    ECHO PLAYER Bram Havarth puffs up the stairs, counts one hundred gold crowns into your hand, and winces at every one.
    ECHO OTHERS Edric Havarth accepts %N's survey report, and Bram pays %i, wincing.
    ADD WEALTH 10000
    AWARD 1040 1000
    EQUAL INTNUM1040 2
  ENDIF
  IFVAR INTNUM1040 = 3
    ECHO PLAYER Edric Havarth reads the report twice. "Well done! Perhaps there's life left in that old hole after all. Your next assignment takes you somewhere rather less conventional, when you're ready for work."
    ECHO PLAYER Bram Havarth puffs up the stairs, counts two hundred and fifty gold crowns into your hand, and mutters about expedition expenses.
    ECHO OTHERS Edric Havarth accepts %N's survey report, and Bram pays %i, muttering.
    ADD WEALTH 25000
    AWARD 1041 2000
    EQUAL INTNUM1040 4
  ENDIF
  IFVAR INTNUM1040 = 5
    ECHO PLAYER Edric Havarth sets the report down very carefully. "Three successful expeditions! You've earned my confidence, and I don't extend that lightly. I believe you're ready for the assignment that truly matters, when you're ready for work."
    ECHO PLAYER Bram Havarth puffs up the stairs and counts five hundred gold crowns into your hand. "Gold coming in is business," he grumbles. "Gold going out is a tragedy."
    ECHO OTHERS Edric Havarth accepts %N's survey report, and Bram pays %i, grumbling.
    ADD WEALTH 50000
    AWARD 1042 4000
    EQUAL INTNUM1040 6
  ENDIF
  IFVAR INTNUM1040 = 7
    ECHO PLAYER Edric Havarth pores over the report, and his face splits into a grin. "Remarkable. Absolutely remarkable! You've done more than locate another vein of ore. You've found us a potential future."
    ECHO PLAYER Bram Havarth, peering over his shoulder, sniffs. "And an expensive future, judging by what it'll cost to establish an operation up there."
    ECHO PLAYER "For once, Uncle, stop counting coins and consider how many we stand to earn!" Edric turns back to you. "You've served this company exceptionally well. Bram has your payment, and Tessa has prepared something special for you. Consider it a token of our gratitude, and a reminder that you'll always have friends at New Havarth Mining."
    ECHO PLAYER Bram counts one thousand gold crowns into your hands, very slowly.
    ECHO PLAYER Tessa Havarth comes in from the workshop carrying a mining axe wrapped in oilcloth. "Father asked me to make you something worthy of the work you've done. Best steel we could obtain, properly balanced, and fitted with a handle that'll outlast most miners." She hands it to you. "Treat it well. And if you ever strike something truly valuable, remember who gave you the axe."
    ECHO OTHERS Edric Havarth accepts %N's report from the Teeth of Shartan. Bram pays %i, and Tessa presents %i with a masterwork mining axe.
    ADD WEALTH 100000
    AWARD 1043 8000
    NEWITEM -1 9401 ADJ1=9401 ADJ2=9402
    EQUAL INTNUM1040 8
  ENDIF
  EQUAL INTNUM1046 0
  EQUAL INTNUM1049 0
ENDIF

; ── Cyclic events ─────────────────────────────────────────────────────────────
; Keep these LAST: a CEVENT body runs until the next NUMBER/INUMBER/MNUMBER/
; CEVENT/MACRO line, so anything after one would be swallowed into it.

; CEVENT 9400 (every ~2m): a Havarth says something, in a company room with
; someone in it.
CEVENT 9400 40 394
IFVAR DUMMY9 = 0
RANDOM DUMMY1 1 8
IFVAR DUMMY1 = 1
  AFFECT 9400
  IFVAR PLRSINROOM > 0
    ECHO ALL Edric Havarth gazes at the map on the wall. "There's wealth beneath these lands. We merely need the courage to find it."
  ENDIF
ENDIF
IFVAR DUMMY1 = 2
  AFFECT 9401
  IFVAR PLRSINROOM > 0
    ECHO ALL Mara Havarth frowns at a chart. "If the latest measurements are accurate, we're looking in entirely the wrong direction."
  ENDIF
ENDIF
IFVAR DUMMY1 = 3
  AFFECT 394
  IFVAR PLRSINROOM > 0
    ECHO ALL Bram Havarth glares at a delivery slip. "Another shipment of equipment? Does nobody in this family understand a budget?"
  ENDIF
ENDIF
IFVAR DUMMY1 = 4
  AFFECT 9402
  IFVAR PLRSINROOM > 0
    ECHO ALL Tessa Havarth holds a pickaxe up to the light. "Whoever returned this pickaxe ought to be ashamed of themselves. Look at that edge!"
  ENDIF
ENDIF
IFVAR DUMMY1 = 5
  AFFECT 394
  IFVAR PLRSINROOM > 0
    ECHO ALL Hammering and sawing echo down from the scaffolding outside, followed by a shout and a clatter of dropped tools.
  ENDIF
ENDIF
IFVAR DUMMY1 = 6
  AFFECT 9400
  IFVAR PLRSINROOM > 0
    ECHO ALL Edric Havarth moves a pin on his map, frowns, and moves it back.
  ENDIF
ENDIF
IFVAR DUMMY1 = 7
  AFFECT 9401
  IFVAR PLRSINROOM > 0
    ECHO ALL Mara Havarth taps a brass instrument, holds it to her ear, and sighs. "Stone doesn't lie. Surveyors sometimes do."
  ENDIF
ENDIF
IFVAR DUMMY1 = 8
  AFFECT 9402
  IFVAR PLRSINROOM > 0
    ECHO ALL Tessa Havarth tests the edge of a freshly ground pick with her thumb. "Good steel lasts longer than good intentions."
  ENDIF
ENDIF
ENDIF
